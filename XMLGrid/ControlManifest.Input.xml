<?xml version="1.0" encoding="utf-8" ?>
<manifest>
  <control namespace="IT" constructor="XMLGrid" version="0.0.1" display-name-key="XMLGrid" description-key="XMLGrid description" control-type="standard" >
    <!--external-service-usage node declares whether this 3rd party PCF control is using external service or not, if yes, this control will be considered as premium and please also add the external domain it is using.
    If it is not using any external service, please set the enabled="false" and DO NOT add any domain below. The "enabled" will be false by default.
    Example1:
      <external-service-usage enabled="true">
        <domain>www.Microsoft.com</domain>
      </external-service-usage>
    Example2:
      <external-service-usage enabled="false">
      </external-service-usage>
    -->
    <external-service-usage enabled="false">
      <!--UNCOMMENT TO ADD EXTERNAL DOMAINS
      <domain></domain>
      <domain></domain>
      -->
    </external-service-usage>
    <!-- dataset node represents a set of entity records on CDS; allow more than one datasets -->
    <property name="fetchXML" display-name-key="Fetch XML" description-key="Fetch XML" of-type="Multiple" usage="bound" required="true" />
    <property name="tableHeaderColor" display-name-key="Table Header Color" description-key="Table Header Color" of-type="SingleLine.Text" usage="input" required="true" default-value="#A1C398"/>
    <property name="recordIds" display-name-key="Record Id's" description-key="Record Id's" of-type="TwoOptions" usage="input" required="true" default-value="false"/>  
    <property name="tableHeight" display-name-key="Table Height" description-key="Table Height" of-type="Decimal" usage="input" required="true" default-value="400"/>  
    <property name="selectedMode" display-name-key="Selection Mode" description-key="Selection Mode" of-type="Enum" usage="input" required="true" default-value="">
      <value name="Single Select" display-name-key="Single Select">Single Select</value>
      <value name="Multi Select" display-name-key="Multi Select">Multi Select</value>
      <value name="None" display-name-key="None">None</value>
    </property>  
    <property name="selectedRows" display-name-key="Selected Rows" description-key="Selected Rows" of-type="Multiple" usage="output" required="true"/>
    <resources>
      <code path="index.ts" order="1"/>
      <css path="css/XMLGrid.css" order="1" />
      <!-- UNCOMMENT TO ADD MORE RESOURCES
      <resx path="strings/XMLGrid.1033.resx" version="1.0.0" />
      -->
    </resources>
    <!-- UNCOMMENT TO ENABLE THE SPECIFIED API
    <feature-usage>
      <uses-feature name="Device.captureAudio" required="true" />
      <uses-feature name="Device.captureImage" required="true" />
      <uses-feature name="Device.captureVideo" required="true" />
      <uses-feature name="Device.getBarcodeValue" required="true" />
      <uses-feature name="Device.getCurrentPosition" required="true" />
      <uses-feature name="Device.pickFile" required="true" />
      <uses-feature name="Utility" required="true" />
      <uses-feature name="WebAPI" required="true" />
    </feature-usage>
    -->
  </control>
</manifest>
